{
  "version": 2,
  "buildCommand": "cd vocal-pitch-trainer && npm run build",
  "outputDirectory": "vocal-pitch-trainer/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/vocal-pitch-trainer/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/vocal-pitch-trainer/dist/index.html"
    }
  ]
}
